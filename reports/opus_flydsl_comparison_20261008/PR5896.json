  "title": "[HIP] [OPUS] [FlyDSL] gfx950 MXFP8 e8m0 GEMM + DeepSeek-V4/V4.1 tuned configs",
  "user": {
    "login": "valarLip",
    "id": 103567126,
    "node_id": "U_kgDOBixPFg",
    "avatar_url": "https://avatars.githubusercontent.com/u/103567126?v=4",
    "gravatar_id": "",
