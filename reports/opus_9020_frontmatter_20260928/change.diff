+template<class T>
+__device__ inline auto make_layout_ga_scale(int lane_id, int wave_id, int stride_a) {
+    constexpr int rows_per_pass = T::BLOCK_SIZE / (T::B_K / T::VEC_A);
+    // Each row contains eight K16 chunks. XOR permutes those chunks within
+    // the row. Cache the three producer addresses in their issue order.
+    auto u = opus::make_layout<T::VEC_A>(
+        opus::make_tuple(opus::number<T::B_M / rows_per_pass>{}, opus::number<T::VEC_A>{}),
+        opus::make_tuple(rows_per_pass * stride_a, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{}));
+    opus::static_for<T::B_M / rows_per_pass>([&](auto p) {
+        constexpr int pass = decltype(p)::value;
+        const int a_row = pass * 64 + wave_id * 8 + lane_id / 8;
+        const int source_chunk = (lane_id % 8) ^ ((a_row >> 1) & 7);
+        u.offsets[p] = a_row * stride_a + source_chunk * 16;
+    });
+    return u;
+}
+
+template<class T>
+__device__ inline auto make_layout_sa_scale(int wave_id) {
+    constexpr int rows_per_pass = T::BLOCK_SIZE / (T::B_K / T::VEC_A);
+    // The direct-to-LDS instruction adds lane_id * VEC_A itself.
+    return opus::make_layout<T::VEC_A>(
+        opus::make_tuple(opus::number<T::B_M / rows_per_pass>{}, opus::number<T::VEC_A>{}),
+        opus::make_tuple(opus::number<rows_per_pass * T::B_K>{}, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{})) +
+        wave_id * T::WARP_SIZE * T::VEC_A;
+}
+
+template<class T>
+__device__ inline auto make_layout_ra_scale(int lane_id, int wave_id_m) {
+    auto u = opus::make_layout<T::VEC_A>(
+        opus::make_tuple(opus::number<T::E_M>{}, 2_I, opus::number<T::VEC_A>{}),
+        opus::make_tuple(opus::number<T::T_M * T::W_M * T::B_K>{}, 64_I, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{}, opus::underscore{}));
+    // Cache the six fragment addresses using the same XOR as the producer.
+    opus::static_for<T::E_M>([&](auto m) {
+        constexpr int repeat = decltype(m)::value;
+        opus::static_for<2>([&](auto c) {
+            constexpr int index = repeat * 2 + decltype(c)::value;
+            const int matrix_row = repeat * T::T_M * T::W_M + wave_id_m * T::W_M + lane_id % T::W_M;
+            const int matrix_chunk = lane_id / T::W_M + decltype(c)::value * 4;
+            const int lds_chunk = matrix_chunk ^ ((matrix_row >> 1) & 7);
+            u.offsets[index] = matrix_row * T::B_K + lds_chunk * 16;
+        });
+    });
+    return u;
+}
+
+template<class T>
+__device__ inline auto make_layout_ssfa_scale(int thread_id) {
+    // The complete scale panel is stored as [K128 group][M row] bytes.
+    return opus::make_layout<16>(
+        opus::make_tuple(opus::number<T::SFA_PASSES>{}, 16_I),
+        opus::make_tuple(opus::number<T::BLOCK_SIZE * 16>{}, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{})) + thread_id * 16;
+}
+
+template<class T>
+__device__ inline auto make_layout_gsfa_scale(int thread_id, int row, int stride_sfa) {
+    auto u = make_layout_ssfa_scale<T>(thread_id);
+    // Convert each panel offset to the corresponding strided global address.
+    opus::static_for<T::SFA_PASSES>([&](auto p) {
+        const int index = u.offsets[p];
+        const int group = index / T::B_M;
+        const int local_row = index % T::B_M;
+        u.offsets[p] = group * stride_sfa + row + local_row;
+    });
+    return u;
+}
+
+template<class T>
+__device__ inline auto make_layout_rsfa_scale(int lane_id, int wave_id_m) {
+    return opus::make_layout<1>(
+        opus::make_tuple(opus::number<T::E_M>{}, 1_I),
+        opus::make_tuple(opus::number<T::T_M * T::W_M>{}, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{})) +
+        wave_id_m * T::W_M + lane_id % T::W_M;
+}
+
+template<class T>
+__device__ inline auto make_layout_gsfb_scale(int thread_id, int col, int stride_sfb) {
+    // Each producer reads the two N128 scale bytes for one K128 group.
+    return opus::make_layout<1>(
+        opus::make_tuple(opus::number<T::B_N / T::GROUP_N>{}, 1_I),
+        opus::make_tuple(stride_sfb, 1_I),
+        opus::make_tuple(opus::underscore{}, opus::underscore{})) +
+        (col / T::GROUP_N) * stride_sfb + thread_id;
+}
+
+__device__ inline auto make_layout_ssfb_scale(int thread_id) {
+    // Offsets count packed uint words, one per K128 group.
+    return opus::make_layout<1>(opus::make_tuple(1_I), opus::make_tuple(1_I),
+                                opus::make_tuple(opus::underscore{})) + thread_id;
+}
+
+__device__ inline auto make_layout_rsfb_scale() {
+    return opus::make_layout<1>(opus::make_tuple(1_I), opus::make_tuple(1_I),
+                                opus::make_tuple(opus::underscore{}));
+}
+
