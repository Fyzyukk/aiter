+template<class T>
+__device__ inline constexpr auto make_layout_gsfb_scale(int lane_id, int wave_id_m, int wave_id_n, int stride_sfb) {
+    constexpr auto block_shape = opus::make_tuple(
+        opus::number<T::B_SCALE_PACKS>{},
